# 需求治理平台 · 离线部署环境变量。安装脚本把本模板复制为 <安装目录>/.env 后由现场填写。
# 本文件与 docker-compose.offline.yml 同目录，同时供编排变量替换与容器内进程读取。
# 硬边界：密钥类取值（LLM_API_KEY、EMBEDDING_API_KEY、POSTGRES_PASSWORD）只写不回显，
# 不得抄进工单、日志或截图。

# ---------------------------------------------------------------- 镜像与端口 --
# 三个镜像标签由安装脚本按包内 manifest.json 自动填写，请勿手工改动。
REQDOC_IMAGE=
REQDOC_DB_IMAGE=
REQDOC_REDIS_IMAGE=

# 对外服务端口。前端页面与 API 同源，只需这一个端口；数据库与 Redis 不对外发布。
APP_PORT=9180

# ------------------------------------------------------------------ 数据库 --
POSTGRES_DB=req_v1
POSTGRES_USER=req_doc
# 首次安装前必须改成现场口令：安装脚本拒绝以下占位值。
POSTGRES_PASSWORD=CHANGE-ME-BEFORE-INSTALL

# ---------------------------------------------------------------- 运行环境 --
APP_ENV=prod

# ------------------------------------------------------- AI 推理服务（外部） --
# 本系统不自带推理服务，指向生产环境已有的 OpenAI 兼容端点（地址须含 /v1）。
# 留空则系统降级运行：AI 对话与要素识别返回占位内容、不调真实模型。
LLM_BASE_URL=
# 需鉴权的服务（如 dashscope）填写；本地 llama.cpp / ollama 留空。
LLM_API_KEY=
# 模型标识，按现场实际加载的模型填写。
LLM_MODEL=qwen3.6-27b
# 推理引擎类型：llama_cpp | ollama | vllm | openai_compatible。
LLM_PROVIDER_TYPE=llama_cpp
# 模型上下文窗口（token），按现场服务端实际配置填写；仅用于提示词超长告警。
LLM_CONTEXT_TOKENS=40960
# 单次回复输出上限（token）。
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=180
# Qwen3 系列推理模型须关思考，否则判定结果为空。
LLM_DISABLE_THINKING=true

# ------------------------------------------------- 向量化服务（外部，可选） --
# 留空则全局检索降级为纯词法匹配（只按词面命中，不做语义相似检索），其余功能不受影响。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
# 维度必须与所选嵌入模型输出一致；改维度需要重新迁移并全量重嵌，不可随意调整。
EMBEDDING_DIM=1024
