#!/bin/bash
# ReqDoc 需求治理平台 —— AppImage 启动入口（单机模式，AppImage 单机模式方案 §5.2）。
# 用法：直接运行＝起后端并打开浏览器；--no-browser 只起后端；--stop 停掉本机在跑的实例；--status 看状态。
set -u
HERE="$(dirname "$(readlink -f "$0")")"
export REQDOC_HOME="${REQDOC_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/reqdoc}"
mkdir -p "$REQDOC_HOME"
export JAVA_PATH="$HERE/usr/jre/bin/java"
export PLANTUML_JAR="$HERE/usr/app/backend/tools/plantuml.jar"
export FRONTEND_DIST="$HERE/usr/app/frontend/dist"
export PYTHONPATH="$HERE/usr/app/backend"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
# 中文字体：包内若带字体目录，就让 fontconfig 同时看到它（PlantUML 经 Java 渲染中文需要）。
if [ -d "$HERE/usr/share/fonts" ]; then
  export FONTCONFIG_FILE="$HERE/usr/share/fonts/fonts.conf"
fi
PY="$HERE/usr/python/bin/python3"
RUNTIME="$REQDOC_HOME/runtime.json"
LOG="$REQDOC_HOME/server.log"

state() {  # 读 runtime.json：输出 "pid port"；没有或进程已死输出空
  [ -f "$RUNTIME" ] || return 0
  "$PY" - "$RUNTIME" <<'PYEOF'
import json, os, sys
try:
    d = json.load(open(sys.argv[1]))
    os.kill(int(d["pid"]), 0)
    print(d["pid"], d["port"])
except Exception:
    pass
PYEOF
}
healthy() { "$PY" -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:$1/api/health', timeout=3); sys.exit(0)" 2>/dev/null; }
free_port() { "$PY" -c "
import socket
p = int('$1')
for cand in range(p, p + 50):
    s = socket.socket()
    try:
        s.bind(('127.0.0.1', cand)); s.close(); print(cand); break
    except OSError:
        s.close()
"; }

case "${1:-}" in
  --stop)
    read -r pid port <<<"$(state)"
    if [ -n "${pid:-}" ]; then kill "$pid" && echo "已停止（pid $pid，端口 $port）"; rm -f "$RUNTIME"; else echo "没有在跑的实例"; fi
    exit 0 ;;
  --status)
    read -r pid port <<<"$(state)"
    if [ -n "${pid:-}" ]; then echo "运行中：pid $pid，地址 http://127.0.0.1:$port，数据目录 $REQDOC_HOME"; else echo "未运行；数据目录 $REQDOC_HOME"; fi
    exit 0 ;;
  --help|-h)
    sed -n '2,3p' "$0"; exit 0 ;;
esac

read -r pid port <<<"$(state)"
if [ -n "${pid:-}" ] && healthy "$port"; then
  echo "实例已在运行（pid $pid）：http://127.0.0.1:$port"
  [ "${1:-}" = "--no-browser" ] || xdg-open "http://127.0.0.1:$port" >/dev/null 2>&1 || true
  exit 0
fi

PORT="$(free_port "${REQDOC_PORT:-8000}")"
[ -n "$PORT" ] || { echo "找不到可用端口"; exit 1; }
echo "数据目录：$REQDOC_HOME"
echo "启动后端（端口 $PORT，日志 $LOG）..."
"$PY" -m uvicorn app.main:app --host 127.0.0.1 --port "$PORT" >>"$LOG" 2>&1 &
PID=$!
printf '{"pid": %s, "port": %s}\n' "$PID" "$PORT" > "$RUNTIME"
trap 'kill $PID 2>/dev/null; rm -f "$RUNTIME"; exit 0' INT TERM

for i in $(seq 90); do
  sleep 1
  if healthy "$PORT"; then
    echo "就绪：http://127.0.0.1:$PORT"
    [ "${1:-}" = "--no-browser" ] || xdg-open "http://127.0.0.1:$PORT" >/dev/null 2>&1 || echo "请用浏览器打开 http://127.0.0.1:$PORT"
    wait $PID
    rm -f "$RUNTIME"
    exit 0
  fi
  kill -0 $PID 2>/dev/null || { echo "后端启动失败，日志见 $LOG"; tail -20 "$LOG"; rm -f "$RUNTIME"; exit 1; }
done
echo "后端 90 秒内未就绪，日志见 $LOG"; kill $PID; rm -f "$RUNTIME"; exit 1
