# 后端配置模板。复制为 backend/.env 并按需填写（.env 不入库）。
# 完整变量清单与默认值见 app/config.py；此处只列开发环境常改的项。

APP_ENV=dev

# --- 数据库（默认对接 docker-compose 的 Postgres，一般无需改）---
DATABASE_URL=postgresql+psycopg://req_doc@localhost:5432/req_v1

# --- 外部 LLM（OpenAI 兼容接口；llama.cpp / ollama / vLLM 均可）---
# 服务地址必须含 /v1，例：http://192.168.1.50:8080/v1
LLM_BASE_URL=
# 模型名（llama.cpp 通常忽略此字段，填你加载的模型标识即可）
LLM_MODEL=qwen2.5
# 供应商类型：llama_cpp（默认）/ 其它见 app/config.py
LLM_PROVIDER_TYPE=llama_cpp
# 鉴权 key（本地 llama.cpp 不需要，留空）
LLM_API_KEY=
LLM_TIMEOUT=180
# 单次生成 token 预算与模型上下文窗口（按你部署的模型实际能力填）
LLM_MAX_TOKENS=131072
LLM_CONTEXT_TOKENS=262144
# Qwen3 等推理模型必须关思考，否则 reasoning 吃光 token、content 为空。默认 true。
LLM_DISABLE_THINKING=true

# --- 异步任务队列（Redis + RQ）---
# 留空 → AI 任务在 API 进程内同步执行（不需要 worker，Windows 原生开发推荐）；
# 填 redis 地址（如 redis://localhost:6379/0）→ 真异步，须另起 rq worker（make worker 或容器 worker）。
REDIS_URL=

# --- 向量检索（可选；不配则全局检索走纯词法）---
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# --- 外部工具路径（可选；留空自动从 PATH 探测，探测不到对应功能降级）---
# soffice：docx→PDF 精确预览（LibreOffice）；mmdc/java：图形源码栅格化
SOFFICE_PATH=
MMDC_PATH=
JAVA_PATH=
