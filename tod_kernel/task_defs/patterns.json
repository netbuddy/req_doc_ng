{
  "说明": "对话模式：使用者岔开主线（提问、含糊、推迟、把握不够）时插入主线、跑完返回的系统级小流程，所有用对话理解的任务共用。路由表由对话理解产出的功能定去向，模型不选模式。步骤参数里可用三种引用取插入段的东西：{\"输入\": 键}（可写点号路径）、{\"上一步结果\": true}、{\"句式\": 带 {键} 的句子}（用输入填空）；这三种引用只在本文件里认。",
  "路由表": [
    {"功能": "REQUEST", "模式": "答疑"},
    {"功能": "CLARIFY", "模式": "澄清"},
    {"功能": "DEFER", "模式": "推迟"},
    {"功能": "INFORM", "条件": "把握低于阈值", "模式": "求证"}
  ],
  "模式": [
    {"名字": "答疑", "输入": ["问"],
     "步骤": [
       {"说明": "用一两句白话解释使用者问的内容", "工具": "答疑", "参数": {"question": {"输入": "问"}}},
       {"说明": "把解释说给使用者", "工具": "告知", "参数": {"text": {"上一步结果": true}}}]},
    {"名字": "澄清", "输入": ["原问"],
     "步骤": [
       {"说明": "以选择类再问：确认这一稿、修改这一稿、先放一放", "工具": "ask",
        "参数": {"target": {"slot": "回复", "path": []}, "hint": {}, "type": "选择",
                "about": {"slot": {"输入": "原问.槽位"}, "path": {"输入": "原问.路径"}},
                "adopt_to": {"输入": "原问.采纳到"}, "options": ["确认这一稿", "修改这一稿", "先放一放"],
                "original": {"输入": "原问"}, "text": "你是想：1 确认这一稿 2 修改这一稿 3 先放一放？"}},
       {"说明": "理解使用者选了哪一项", "工具": "对话理解", "参数": {}}]},
    {"名字": "推迟", "输入": ["槽位"],
     "步骤": [
       {"说明": "告诉使用者这一项先放着", "工具": "告知", "参数": {"text": {"句式": "『{槽位}』先放着，回头再问。"}}},
       {"说明": "在目标槽位写已推迟标记", "工具": "标记推迟", "参数": {"slot": {"输入": "槽位"}}}]},
    {"名字": "求证", "输入": ["槽位", "路径", "值"],
     "步骤": [
       {"说明": "问使用者这个值记得对不对", "工具": "ask",
        "参数": {"target": {"slot": "回复", "path": []}, "hint": {}, "type": "求证",
                "about": {"slot": {"输入": "槽位"}, "path": {"输入": "路径"}},
                "options": [{"输入": "值"}], "text": {"句式": "你说的『{值}』我记成『{槽位}』，对吗？"}}},
       {"说明": "理解使用者的回答：对就写这个值，不对不写", "工具": "对话理解", "参数": {}}]}
  ]
}
