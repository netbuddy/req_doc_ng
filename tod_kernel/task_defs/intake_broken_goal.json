{
  "名字": "材料接入登记（登记破坏确认目标）",
  "槽位": {
    "目录":     {"说明": "要登记的材料所在目录", "类型": "文本"},
    "文件总表": {"说明": "目录里全部文件名的列表", "类型": "列表"},
    "材料清单": {"说明": "逐个登记的文件信息", "类型": "列表", "默认值": [],
                "项": {"文件名": {"说明": "文件名", "类型": "文本"}, "类型": {"说明": "文件类型", "类型": "文本"},
                       "大小": {"说明": "字节数", "类型": "数字"}, "页数": {"说明": "页数", "类型": "数字"},
                       "是否纳入": {"说明": "使用者是否把它纳入项目", "类型": "枚举", "取值": ["是", "否"],
                                   "提问": "请确认是否把文件 {file} 纳入项目。"}}},
    "登记进度": {"说明": "已登记的文件数", "类型": "数字", "默认值": 0},
    "清单文件路径": {"说明": "生成的清单文件位置", "类型": "文本"}
  },
  "阶段列表": [
    {"名字": "列目录", "类型": "固定步骤", "目标": [{"谓词": "不为空", "槽位": "文件总表"}],
     "步骤": [{"说明": "列出目录里的全部文件，填入文件总表", "工具": "list_dir", "参数": {}}]},
    {"名字": "确认", "类型": "固定步骤",
     "目标": [{"谓词": "列表无项为空", "槽位": "材料清单", "字段": "是否纳入"}],
     "步骤": [{"说明": "请使用者确认下一个未答文件是否纳入", "工具": "ask", "参数": {
                "target": {"slot": "材料清单", "path": [{"首个为空项": ["材料清单", "是否纳入"]}, "是否纳入"]},
                "hint": {"file": {"首个为空项字段": ["材料清单", "是否纳入", "文件名"]}}},
              "重复直到": [{"谓词": "列表无项为空", "槽位": "材料清单", "字段": "是否纳入"}],
              "最多": {"长度": "文件总表"}}]},
    {"名字": "登记", "类型": "固定步骤",
     "目标": [{"谓词": "相等", "左": {"槽位": "登记进度"}, "右": {"长度": "文件总表"}}],
     "步骤": [{"说明": "登记下一个文件的名字、类型、大小、页数", "工具": "register_file", "参数": {"index": {"槽位": "登记进度"}},
              "重复直到": [{"谓词": "相等", "左": {"槽位": "登记进度"}, "右": {"长度": "文件总表"}}],
              "最多": {"长度": "文件总表"}}]}
  ],
  "交付物": [
    {"名字": "材料清单", "说明": "逐个文件的登记与纳入结论", "来源": "材料清单", "形态": "表格"}
  ]
}